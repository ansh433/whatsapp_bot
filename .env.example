# Copy this file to .env and fill in the values.

# --- WhatsApp (Meta Cloud API) ---
# Meta developer dashboard -> your app -> WhatsApp -> API Setup
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
# Any string you invent; you type the same one into Meta's webhook settings
VERIFY_TOKEN=glow-verify
# Staff WhatsApp number for handoffs: digits only with country code, e.g. 919876543210.
# It must be one of the recipient numbers you added on the API Setup page.
STAFF_NUMBER=

# --- Gemini (Google AI Studio) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# --- Google Sheets ---
# The long id in the sheet URL: docs.google.com/spreadsheets/d/<SHEET_ID>/edit
SHEET_ID=
# Service-account key file; share the sheet with that account's email (Editor)
GOOGLE_CREDENTIALS_FILE=service_account.json
